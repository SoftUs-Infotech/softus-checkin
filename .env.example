# Where the browser finds the API. In development leave it unset: Vite proxies
# /api to the local backend, so the app and the API share an origin.
#
# On Vercel set it in Project Settings > Environment Variables, e.g.
#   VITE_API_BASE=https://api.example.com/api/v1
# A production build on Vercel without it fails on purpose — the app would
# otherwise ship pointing at an /api path that does not exist there.
VITE_API_BASE=
